{
  "bsonType": "object",
  "description": "用户每次答题的不可变流水，使用事件ID防止重试重复写入",
  "required": [
    "_id",
    "eventId",
    "userId",
    "subjectId",
    "questionId",
    "selected",
    "correct",
    "occurredAt",
    "createdAt"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "userId 与客户端事件ID组成的幂等ID",
      "minLength": 3,
      "maxLength": 160
    },
    "eventId": {
      "bsonType": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "userId": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "subjectId": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "questionId": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "selected": {
      "bsonType": "array",
      "arrayType": "string",
      "minLength": 1,
      "maxLength": 6,
      "items": {
        "bsonType": "string",
        "enum": ["A", "B", "C", "D", "E", "F"]
      }
    },
    "correct": {
      "bsonType": "bool"
    },
    "occurredAt": {
      "bsonType": "date"
    },
    "createdAt": {
      "bsonType": "date"
    }
  }
}
