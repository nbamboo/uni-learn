{
  "bsonType": "object",
  "description": "会员续订时按用户和科目控制本机/云端学习数据替换，并拦截清空前的延迟事件",
  "required": [
    "_id",
    "userId",
    "subjectId",
    "status",
    "replacementId",
    "capturedAt",
    "clearedAt",
    "createdAt",
    "updatedAt"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "userId与subjectId组成的稳定ID",
      "minLength": 3,
      "maxLength": 140
    },
    "userId": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "subjectId": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "bsonType": "string",
      "enum": ["replacing", "ready"]
    },
    "replacementId": {
      "bsonType": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "capturedAt": {
      "bsonType": "date"
    },
    "clearedAt": {
      "bsonType": "date"
    },
    "completedAt": {
      "bsonType": "date"
    },
    "createdAt": {
      "bsonType": "date"
    },
    "updatedAt": {
      "bsonType": "date"
    }
  }
}
