{
  "bsonType": "object",
  "description": "用户按章节或知识点保存的最后停留题目，每个练习范围固定一条",
  "required": [
    "_id",
    "userId",
    "subjectId",
    "mode",
    "scopeKey",
    "chapterId",
    "questionId",
    "progressId",
    "progressAt",
    "createdAt",
    "updatedAt"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "userId、subjectId、mode和scopeKey哈希组成的稳定ID",
      "minLength": 8,
      "maxLength": 192
    },
    "userId": {
      "bsonType": "string",
      "description": "由 uni-id token 解析得到，禁止客户端指定其他用户",
      "minLength": 1,
      "maxLength": 64
    },
    "subjectId": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "bsonType": "string",
      "enum": ["chapter", "knowledge"],
      "description": "进度所属的练习范围类型"
    },
    "scopeKey": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "章节模式为chapterId，知识点模式为knowledge"
    },
    "chapterId": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "knowledge": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "questionId": {
      "bsonType": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "progressId": {
      "bsonType": "string",
      "minLength": 8,
      "maxLength": 96,
      "description": "客户端本次进度更新ID"
    },
    "progressAt": {
      "bsonType": "date",
      "description": "用户实际逗留到该题目的时间"
    },
    "createdAt": { "bsonType": "date" },
    "updatedAt": { "bsonType": "date" }
  }
}
