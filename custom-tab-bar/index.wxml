<cover-view class="tab-bar {{tablet ? 'tab-bar--tablet' : ''}} {{nightMode ? 'tab-bar--night' : ''}}">
  <cover-view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tab-bar__item"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <cover-image
      class="tab-bar__icon"
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
    />
    <cover-view class="tab-bar__label {{selected === index ? 'tab-bar__label--selected' : ''}}">
      {{item.text}}
    </cover-view>
  </cover-view>
</cover-view>
